{
  "name": "gathering-games",
  "version": "1.0.0",
  "description": "Arabic gathering party games platform",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "build:questions": "node scripts/validate-questions.js && node scripts/build-questions.js",
    "validate:questions": "node scripts/validate-questions.js",
    "start": "node server/index.js",
    "test:rooms": "node scripts/test-rooms.js",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=18"
  }
}
